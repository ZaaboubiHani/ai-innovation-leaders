# Copy this file to .env.local and fill in the values.

# MongoDB connection string.
# Local MongoDB / Docker:  mongodb://127.0.0.1:27017/ai-innovation-leaders
# MongoDB Atlas:           mongodb+srv://<user>:<password>@<cluster>/ai-innovation-leaders?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai-innovation-leaders

# Long random string used to hash visitor IP addresses (raw IPs are never stored).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=change-me-to-a-long-random-string

# Public site URL (used for metadata and the same-origin check on form submissions).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shown in the footer and on the Apply page when set.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: currency label shown next to the indicative tuition figures (e.g. DZD).
# The source document gives amounts without a currency, so confirm it before launch.
NEXT_PUBLIC_TUITION_CURRENCY=

# --- Admin dashboard (/admin) -------------------------------------------------
# Generate all three with:  npm run admin:hash -- "your-strong-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
